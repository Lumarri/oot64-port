{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MM3D: compilar modulo privado ARM64",
      "type": "process",
      "command": "wsl",
      "args": ["-d", "Ubuntu", "--", "bash", "tools/android/build_title.sh"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: probar carga del modulo privado en USB",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/test_title.py"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: ejecutar inicio real hasta primer SVC en USB",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/test_startup.py"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: compilar APK de prueba visible",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/build_window_apk.py"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: instalar y probar APK visible en USB",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/test_window_app.py", "--install"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: probar shaders GLES en WSL (software)",
      "type": "process",
      "command": "wsl",
      "args": ["-d", "Ubuntu", "--", "bash", "tools/android/test_gles_host.sh"],
      "problemMatcher": ["$gcc"],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: comprobar GPU del teléfono USB",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/check_device.py"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: preparar NDK en WSL",
      "type": "process",
      "command": "wsl",
      "args": ["-d", "Ubuntu", "--", "bash", "tools/android/setup_ndk.sh"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: compilar base Android ARM64",
      "type": "process",
      "command": "wsl",
      "args": ["-d", "Ubuntu", "--", "bash", "tools/android/build_native.sh"],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true },
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "MM3D: probar base ARM64 en teléfono USB",
      "type": "process",
      "command": "python",
      "args": ["-B", "tools/android/test_device.py"],
      "problemMatcher": [],
      "options": { "cwd": "${workspaceFolder}" }
    },
    {
      "label": "Android: listar dispositivos",
      "type": "process",
      "command": "adb",
      "args": ["devices", "-l"],
      "problemMatcher": []
    },
    {
      "label": "Android: modelo del teléfono USB",
      "type": "process",
      "command": "adb",
      "args": ["-d", "shell", "getprop", "ro.product.model"],
      "problemMatcher": []
    },
    {
      "label": "Android: versión del teléfono USB",
      "type": "process",
      "command": "adb",
      "args": ["-d", "shell", "getprop", "ro.build.version.release"],
      "problemMatcher": []
    },
    {
      "label": "Android: arquitecturas del teléfono USB",
      "type": "process",
      "command": "adb",
      "args": ["-d", "shell", "getprop", "ro.product.cpu.abilist"],
      "problemMatcher": []
    },
    {
      "label": "MM3D: verificar y extraer ROM local",
      "type": "process",
      "command": "python",
      "args": ["tools/extract_mm3d_rom.py"],
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
